{
  "name": "raccourci",
  "version": "0.1.0",
  "description": "A minimal, framework-agnostic parser for relative amounts.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/umd/index.cjs"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./umd": {
      "types": "./dist/umd/index.d.cts",
      "default": "./dist/umd/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build --mode umd",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "happy-dom": "^20.14.6",
    "terser": "^5.51.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "input",
    "percentage",
    "fraction",
    "amount",
    "typescript"
  ],
  "unpkg": "./dist/umd/index.cjs",
  "jsdelivr": "./dist/umd/index.cjs"
}
