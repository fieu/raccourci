{
  "name": "raccourci",
  "version": "0.1.0",
  "description": "A minimal, framework-agnostic parser for relative amounts.",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["./dist/umd/index.js"],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {"types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js"},
      "require": {"types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js"}
    },
    "./umd": {"types": "./dist/umd/index.d.ts", "default": "./dist/umd/index.js"}
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {"happy-dom": "^20.14.6", "terser": "^5.51.2", "typescript": "^5.9.0"},
  "keywords": ["input", "percentage", "fraction", "amount", "typescript"],
  "unpkg": "./dist/umd/index.js",
  "jsdelivr": "./dist/umd/index.js"
}
